{
  "model_file": "best_model.pkl",
  "model_type": "XGBoost",
  "target": "selling_price (INR, nominal, CarDekho listing prices; data snapshot ~2020)",
  "reference_year_for_age": 2026,
  "how_to_use": "Pass ONE row (DataFrame with these exact raw columns). Encoding/imputation/log-transform happen inside the pipeline. See predict.py.",
  "requires_module": "car_features.py must be importable when loading best_model.pkl",
  "input_fields": {
    "year": {
      "dtype": "int",
      "required": true,
      "description": "Manufacturing year",
      "train_min": 1983,
      "train_max": 2020
    },
    "km_driven": {
      "dtype": "int",
      "required": true,
      "description": "Odometer reading in km",
      "train_min": 1000,
      "train_max": 577414
    },
    "fuel": {
      "dtype": "str",
      "required": true,
      "allowed_values": [
        "CNG",
        "Diesel",
        "LPG",
        "Petrol"
      ]
    },
    "seller_type": {
      "dtype": "str",
      "required": true,
      "allowed_values": [
        "Dealer",
        "Individual",
        "Trustmark Dealer"
      ]
    },
    "transmission": {
      "dtype": "str",
      "required": true,
      "allowed_values": [
        "Automatic",
        "Manual"
      ]
    },
    "owner": {
      "dtype": "str",
      "required": true,
      "allowed_values": [
        "First Owner",
        "Fourth & Above Owner",
        "Second Owner",
        "Third Owner"
      ]
    },
    "mileage": {
      "dtype": "float",
      "required": false,
      "description": "Fuel efficiency: kmpl (petrol/diesel) or km/kg (CNG/LPG). null -> median-imputed",
      "train_min": 9.0,
      "train_max": 42.0
    },
    "engine": {
      "dtype": "float",
      "required": false,
      "description": "Engine displacement in CC. null -> median-imputed",
      "train_min": 624.0,
      "train_max": 3604.0
    },
    "max_power": {
      "dtype": "float",
      "required": false,
      "description": "Max power in bhp. null -> median-imputed",
      "train_min": 32.8,
      "train_max": 400.0
    },
    "seats": {
      "dtype": "float",
      "required": false,
      "description": "Number of seats. null -> median-imputed",
      "train_min": 2.0,
      "train_max": 14.0
    },
    "brand": {
      "dtype": "str",
      "required": true,
      "allowed_values": [
        "Ambassador",
        "Ashok",
        "Audi",
        "BMW",
        "Chevrolet",
