        "Opel",
        "Peugeot",
        "Renault",
        "Skoda",
        "Tata",
        "Toyota",
        "Volkswagen",
        "Volvo"
      ],
      "note": "Brands with <10 training rows are pooled into an 'infrequent' bucket; unseen brands are handled gracefully (treated as unknown, tier defaults to 'mid')."
    }
  },
